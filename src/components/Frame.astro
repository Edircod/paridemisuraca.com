---
import { copy, type Lang } from '../i18n/copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const items = [
  { id: 'cosa-costruisco', label: t.nav.build },
  { id: 'metodo', label: t.nav.method },
  { id: 'chi-sono', label: t.nav.about },
  { id: 'fuori-orario', label: t.nav.beyond },
  { id: 'console', label: t.nav.console },
  { id: 'contatti', label: t.nav.contact },
];
---

<div class="band" aria-hidden="true"></div>

<header class="margin-top">
  <a class="brand" href={lang === 'it' ? '/' : '/en/'} aria-label={t.nav.home} data-home>
    <img src="/logo-mark.png" alt="" width="117" height="108" />
  </a>
  <div class="end">
    <nav class="nav" aria-label={t.nav.label}>
      <ul>
        {items.map((it) => <li><a href={`#${it.id}`} data-nav={it.id}>{it.label}</a></li>)}
      </ul>
    </nav>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-panel" data-menu-toggle>
      <span class="burger" aria-hidden="true"></span>
      <span data-open>{t.nav.menu}</span><span data-close hidden>{t.nav.close}</span>
    </button>
    <p class="lang" role="group" aria-label={t.nav.lang}>
      <a href="/" aria-current={lang === 'it' ? 'true' : undefined} lang="it">IT</a>
      <a href="/en/" aria-current={lang === 'en' ? 'true' : undefined} lang="en">EN</a>
    </p>
  </div>
</header>

<div class="menu-panel" id="menu-panel" data-menu-panel hidden>
  <ul>
    {items.map((it) => <li><a href={`#${it.id}`}>{it.label}</a></li>)}
  </ul>
</div>

<footer class="margin-bottom">
  <p class="base mono">
    <svg class="globe" viewBox="0 0 16 16" aria-hidden="true">
      <circle cx="8" cy="8" r="6.5"></circle>
      <ellipse cx="8" cy="8" rx="2.8" ry="6.5"></ellipse>
      <path d="M1.5 8h13M2.7 4.5h10.6M2.7 11.5h10.6"></path>
    </svg>
    {t.chart.base}
  </p>
</footer>

<style>
  /* The top bar's ground, so the page scrolls away under it. */
  .band {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    height: var(--bar);
    background: var(--ink);
    pointer-events: none;
  }

  .margin-top,
  .margin-bottom {
    position: fixed;
    left: calc(var(--frame) + 4px);
    right: calc(var(--frame) + 4px);
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .margin-top { top: 0; height: var(--bar); }
  .margin-bottom { bottom: 0; height: var(--foot); justify-content: flex-end; color: var(--mute); }
  .brand {
    display: flex;
    align-items: center;
    height: 100%;
    padding-inline: 4px;
  }
  .brand img {
    display: block;
    width: auto;
    height: 38px;
  }
  .base {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  /* Online lamp: a mint globe breathing slowly. */
  .globe {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--mint);
    stroke-width: 1.2;
    filter: drop-shadow(0 0 4px var(--mint));
    animation: online 3.2s ease-in-out infinite;
  }
  @keyframes online {
    50% { opacity: 0.4; }
  }
  @media (prefers-reduced-motion: reduce) {
    .globe { animation: none; }
  }
  .end {
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.4vw, 36px);
  }

  /* Plain links, the current section underlined in the accent. */
  .nav ul {
    display: flex;
    gap: clamp(16px, 2vw, 32px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav a,
  .lang a {
    text-decoration: none;
    color: var(--mute);
    transition: color 160ms ease;
  }
  .nav a {
    position: relative;
    display: block;
    padding: 10px 0;
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 2px;
    background: var(--grad);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 260ms var(--ease-out);
  }
  .nav a[aria-current='location'] {
    color: var(--paper);
  }
  .nav a[aria-current='location']::after {
    transform: scaleX(1);
  }
  .lang {
    display: flex;
    align-items: center;
    padding-left: clamp(20px, 2.4vw, 36px);
    border-left: 1px solid var(--rule);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .lang a {
    padding: 8px 6px;
  }
  .lang a[aria-current='true'] {
    color: var(--paper);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav a:hover,
    .lang a:hover { color: var(--paper); }
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--paper);
    font: 500 0.9375rem var(--font-sans);
    cursor: pointer;
  }
  .burger {
    width: 18px;
    height: 8px;
    border-block: 1.5px solid currentColor;
  }
  .menu-panel {
    position: fixed;
    inset: var(--bar) var(--frame) var(--foot);
    z-index: 45;
    display: grid;
    align-content: center;
    padding: 0 var(--gutter);
    background: var(--ink);
  }
  .menu-panel[hidden] { display: none; }
  .menu-panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu-panel a {
    display: block;
    padding: 10px 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 9vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .nav { display: none; }
    .menu-toggle { display: flex; }
    .brand img { height: 32px; }
  }
  /* Fingers need more than the boxes show: the hit areas take the full height of the bar. */
  @media (pointer: coarse) {
    .lang a,
    .menu-toggle { position: relative; }
    .lang a::after,
    .menu-toggle::after {
      content: '';
      position: absolute;
      inset: -7px -3px;
    }
  }
</style>

<script>
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];

  // Every section is observed, so one without a nav entry clears the highlight.
  const sections = document.querySelectorAll('main > section');
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      for (const a of navLinks) {
        if (a.dataset.nav === e.target.id) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    }
  }, { rootMargin: '-45% 0px -50% 0px' });
  sections.forEach((s) => io.observe(s));

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]')!;
  const setOpen = (open: boolean) => {
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector<HTMLElement>('[data-open]')!.hidden = open;
    toggle.querySelector<HTMLElement>('[data-close]')!.hidden = !open;
  };
  toggle.addEventListener('click', () => setOpen(panel.hidden));
  // The logo leads home; on the home page itself it just glides back to the top.
  document.querySelector<HTMLAnchorElement>('[data-home]')!.addEventListener('click', (e) => {
    if (location.pathname !== new URL((e.currentTarget as HTMLAnchorElement).href).pathname) return;
    e.preventDefault();
    setOpen(false);
    scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
  });
  panel.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
