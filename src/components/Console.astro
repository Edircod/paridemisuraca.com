---
import { commands, copy, folders, links, stack, type Lang } from '../i18n/copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const prompt = 'paride@misuraca:~$';
const setup = { copy: t.console, lang, email: links.email, stack, commands, folders };
---

<section class="section deck" id="console" aria-labelledby="console-title" data-deck data-setup={JSON.stringify(setup)}>
  <canvas class="cloud" aria-hidden="true" data-cloud></canvas>
  <div class="head">
    <h2 id="console-title" data-reveal="lines">{t.console.title}</h2>
    <p class="intro">{t.console.intro}</p>
  </div>
  <div class="term" data-term>
    <p class="bar mono" aria-hidden="true"><span>paride@misuraca — zsh</span><span class="lights"><i></i><i></i><i></i></span></p>
    <div class="out mono" role="log" aria-live="polite" data-out></div>
    <form class="input mono" data-console-form>
      <label for="console-input"><span aria-hidden="true">{prompt}</span><span class="sr-only">{t.console.input}</span></label>
      <input id="console-input" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="send" />
    </form>
  </div>
  <div class="chips">
    {t.console.chips.map((c) => <button class="chip mono" type="button" data-run={c}>{c}</button>)}
  </div>
</section>

<style>
  .deck {
    position: relative;
    overflow: hidden;
  }
  .cloud {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }
  .head,
  .term,
  .chips {
    position: relative;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
    max-width: 880px;
    margin: 0 auto;
  }
  .intro {
    color: var(--mute);
  }
  .term {
    max-width: 880px;
    margin: 32px auto 0;
    border: 1px solid color-mix(in srgb, var(--paper) 28%, transparent);
    background: var(--ink-raised);
    box-shadow: 0 0 0 1px var(--ink), 0 30px 80px -30px color-mix(in srgb, var(--violet) 45%, transparent);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    padding: 10px 16px;
    border-bottom: 1px solid var(--rule);
    color: var(--mute);
  }
  .lights {
    display: flex;
    gap: 6px;
  }
  .lights i {
    width: 8px;
    height: 8px;
    border: 1px solid var(--mute);
  }
  .lights i:first-child {
    border-color: var(--signal);
    background: var(--signal);
  }
  .out {
    height: clamp(220px, 34svh, 340px);
    padding: 18px 20px 6px;
    overflow-y: auto;
    font-size: 0.9375rem;
    line-height: 1.65;
    text-transform: none;
    letter-spacing: 0.02em;
    scrollbar-width: thin;
  }
  .out :global(p) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--paper);
  }
  .out :global(.echo) {
    color: var(--mute);
  }
  .out :global(.echo b) {
    font-weight: 400;
    color: var(--signal);
  }
  .out :global(.err) {
    color: var(--violet);
  }
  .out :global(a) {
    color: var(--signal);
  }
  .input {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px 18px;
    font-size: 0.9375rem;
    text-transform: none;
    letter-spacing: 0.02em;
  }
  label {
    flex: none;
    color: var(--signal);
  }
  input {
    flex: 1;
    min-width: 0;
    padding: 4px 0;
    border: 0;
    background: transparent;
    color: var(--paper);
    font: inherit;
    caret-color: var(--signal);
  }
  input:focus-visible {
    outline: none;
  }
  .term:focus-within {
    border-color: color-mix(in srgb, var(--signal) 70%, transparent);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    max-width: 880px;
    margin: 20px auto 0;
  }
  .chip {
    padding: 8px 14px;
    border: 1px solid var(--rule);
    background: var(--ink);
    color: var(--paper);
    text-transform: none;
    cursor: pointer;
    transition:
      border-color 200ms ease,
      color 200ms ease,
      transform 160ms var(--ease-out);
  }
  .chip:active {
    transform: scale(0.97);
  }
  @media (pointer: coarse) {
    .chip {
      min-height: 44px;
    }
    input {
      min-height: 44px;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .chip:hover {
      border-color: var(--signal);
      color: var(--signal);
    }
  }
  .term:global(.loud) {
    animation: loud 90ms steps(2) 7;
  }
  .term:global(.swell)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, color-mix(in srgb, var(--violet) 30%, transparent) 50%, transparent 70%);
    background-size: 300% 100%;
    pointer-events: none;
    animation: sweep 1.2s var(--ease-in-out) forwards;
  }
  @keyframes loud {
    0% {
      transform: translate(-3px, 1px);
      box-shadow: -4px 0 0 var(--violet), 4px 0 0 var(--signal);
    }
    100% {
      transform: translate(3px, -1px);
      box-shadow: 4px 0 0 var(--violet), -4px 0 0 var(--signal);
    }
  }
  @keyframes sweep {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0 0;
    }
  }

  @media (max-width: 860px) {
    .out {
      font-size: 0.8125rem;
    }
    .input {
      font-size: 0.8125rem;
    }
  }
</style>

<script>
  import { mountConsole, type ConsoleSetup } from '../scripts/console';
  import { mountStackCloud } from '../scripts/stack-cloud';

  const deck = document.querySelector<HTMLElement>('[data-deck]')!;
  const setup: ConsoleSetup = JSON.parse(deck.dataset.setup!);
  const cloud = mountStackCloud(deck, deck.querySelector<HTMLCanvasElement>('[data-cloud]')!, setup.stack);
  mountConsole(deck, setup, () => cloud.burst());
</script>
