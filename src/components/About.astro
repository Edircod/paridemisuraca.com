---
import { copy, type Lang } from '../i18n/copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang].about;
---

<section class="section about" id="chi-sono" aria-labelledby="about-title">
  <figure class="portrait">
    <div class="stage" data-glyph role="img" aria-label={t.portraitLabel}>
      <canvas aria-hidden="true"></canvas>
    </div>
  </figure>
  <div class="text">
    <h2 id="about-title" data-reveal="lines">{t.title}</h2>
    {t.body.map((p) => <p class="body" data-reveal="lines">{p}</p>)}
    <div class="presence">
      <div class="globe" data-globe role="img" aria-label={t.globe}>
        <canvas aria-hidden="true"></canvas>
      </div>
      <div>
        <dl>
          <div class="entry">
            <dt class="mono">{t.active}</dt>
            <dd class="where" data-reveal="decode">{t.where}</dd>
            <dd class="status mono"><span class="led" aria-hidden="true"></span>{t.status}</dd>
          </div>
          <div class="entry">
            <dt class="mono">{t.languages}</dt>
            <dd>{t.languagesValue}</dd>
          </div>
        </dl>
        <p class="drag mono" aria-hidden="true">{t.drag}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: center;
  }
  .portrait {
    grid-column: 1 / span 6;
  }
  .stage {
    position: relative;
    width: min(100%, 600px);
    aspect-ratio: 57.6 / 58;
    cursor: crosshair;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .text {
    grid-column: 7 / span 6;
  }
  h2 {
    font-size: clamp(2.25rem, 4vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.025em;
  }
  .body {
    max-width: 52ch;
    margin-top: 28px;
    font-size: 1.1875rem;
    color: var(--paper);
  }
  .body + .body {
    margin-top: 16px;
    color: var(--mute);
  }
  .presence {
    display: grid;
    grid-template-columns: clamp(150px, 15vw, 210px) 1fr;
    gap: 28px;
    align-items: center;
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }
  .globe {
    position: relative;
    aspect-ratio: 1;
    cursor: grab;
    touch-action: pan-y;
  }
  .globe:global(.dragging) {
    cursor: grabbing;
  }
  .entry + .entry {
    margin-top: 20px;
  }
  dt {
    color: var(--mute);
  }
  dd {
    margin-top: 4px;
  }
  .where {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--signal);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    color: var(--paper);
  }
  .led {
    width: 7px;
    height: 7px;
    background: var(--signal);
    animation: blink 1.6s steps(2, jump-none) infinite;
  }
  .drag {
    margin-top: 20px;
    color: var(--violet);
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .led {
      animation: none;
    }
  }
  @media (hover: none) {
    .drag {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .portrait,
    .text {
      grid-column: 1 / -1;
    }
    .stage {
      margin: 0 auto 48px;
    }
  }
  @media (max-width: 420px) {
    .presence {
      grid-template-columns: 132px 1fr;
      gap: 20px;
    }
  }
</style>

<script>
  import { mountGlyphPortrait, type FieldData } from '../scripts/glyph-portrait';
  import { mountGlobe } from '../scripts/globe';

  function lazy<T>(el: HTMLElement, url: string, mount: (data: T) => void) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        fetch(url)
          .then((r) => r.json() as Promise<T>)
          .then(mount);
      },
      { rootMargin: '400px 0px' },
    );
    io.observe(el);
  }

  const stage = document.querySelector<HTMLElement>('[data-glyph]')!;
  lazy(stage, '/data/about.json', (data: FieldData) => mountGlyphPortrait(stage, stage.querySelector('canvas')!, data));
  const globe = document.querySelector<HTMLElement>('[data-globe]')!;
  lazy(globe, '/data/globe.json', (dots: number[]) => mountGlobe(globe, globe.querySelector('canvas')!, dots));
</script>
