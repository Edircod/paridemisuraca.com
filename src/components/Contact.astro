---
import { copy, links, type Lang } from '../i18n/copy';
import Scroller from './Scroller.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang].contact;
const channels = [
  { label: 'Fiverr', href: links.fiverr },
  { label: 'LinkedIn', href: links.linkedin },
  { label: 'GitHub', href: links.github },
];
---

<section class="section contact" id="contatti" aria-labelledby="contact-title">
  <div class="head">
    <h2 id="contact-title" data-reveal="lines">{t.title}</h2>
    <p class="intro" data-reveal="lines">{t.intro}</p>
  </div>

  <div class="grid">
    <form class="form" data-form data-subject={t.subject} data-sending={t.sending} data-sent={t.sent}>
      <label class="field">
        <span>{t.name}</span>
        <input name="name" type="text" autocomplete="name" required />
      </label>
      <label class="field">
        <span>{t.email}</span>
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <label class="field">
        <span>{t.message}</span>
        <textarea name="message" rows="5" required></textarea>
      </label>
      <input class="trap" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="submit">
        <button class="btn btn-signal" type="submit" data-submit>
          <span data-label>{t.send}</span>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
        </button>
        <p class="status" role="status" aria-live="polite" data-status></p>
        <p class="status error" role="alert" data-error hidden>
          {t.error} <a href={`mailto:${links.email}`}>{links.email}</a>
        </p>
      </div>
    </form>

    <div class="channels">
      <p class="or">{t.channels}</p>
      <div class="mail">
        <a href={`mailto:${links.email}`}>{links.email}</a>
        <button class="copy" type="button" data-copy={links.email} data-done={t.copied}>{t.copy}</button>
      </div>
      <ul>
        {
          channels.map((c) => (
            <li>
              <a href={c.href} target="_blank" rel="noopener">
                {c.label}
                <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                  <path d="M4 2h8v8M12 2 2 12" fill="none" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="end">
    <Scroller text={copy[lang].scrollerEnd} speed={-60} />
  </div>
  <p class="colophon">© Paride Misuraca</p>
</section>

<style>
  .contact {
    padding-bottom: 72px;
  }
  .head {
    max-width: 900px;
  }
  .intro {
    margin-top: 24px;
    color: var(--mute);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    margin-top: clamp(48px, 7vh, 80px);
  }
  .form {
    grid-column: 1 / span 6;
    display: grid;
    gap: 28px;
  }
  .field {
    display: grid;
    gap: 8px;
  }
  .field span {
    font-size: 0.875rem;
    color: var(--mute);
  }
  input,
  textarea {
    width: 100%;
    padding: 10px 0;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 35%, transparent);
    border-radius: 0;
    background: transparent;
    color: var(--paper);
    font: 400 1.125rem/1.5 var(--font-sans);
    transition: border-color 200ms ease;
  }
  textarea {
    resize: vertical;
    min-height: 120px;
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-bottom-color: var(--signal);
  }
  .trap {
    position: absolute;
    left: -9999px;
  }
  .submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }
  .btn[disabled] {
    cursor: progress;
    opacity: 0.7;
  }
  .status {
    color: var(--mute);
  }
  .error {
    color: var(--paper);
  }

  .channels {
    grid-column: 8 / span 5;
  }
  .or {
    color: var(--mute);
  }
  .mail {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 20px;
    margin-top: 14px;
  }
  .mail a {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(var(--signal), var(--signal)) 0 100% / 0 2px no-repeat;
    transition: background-size 320ms var(--ease-out);
  }
  .copy {
    padding: 6px 12px;
    border: 1px solid var(--rule);
    background: none;
    color: var(--mute);
    font: 500 0.8125rem var(--font-sans);
    cursor: pointer;
    transition:
      color 200ms ease,
      border-color 200ms ease,
      transform 160ms var(--ease-out);
  }
  .copy:active {
    transform: scale(0.97);
  }
  @media (pointer: coarse) {
    .copy {
      min-height: 44px;
      padding: 0 16px;
    }
  }
  .channels ul {
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }
  .channels li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    border-top: 1px solid var(--rule);
    font-size: 1.125rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 200ms ease;
  }
  .channels li svg {
    transition: transform 240ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .mail a:hover {
      background-size: 100% 2px;
    }
    .copy:hover {
      color: var(--paper);
      border-color: var(--paper);
    }
    .channels li a:hover {
      color: var(--signal);
    }
    .channels li a:hover svg {
      transform: translate(2px, -2px);
    }
  }

  .end {
    --scroller-h: clamp(96px, 14vh, 136px);
    margin: clamp(72px, 12vh, 140px) calc(-1 * var(--gutter)) 0;
  }
  .colophon {
    margin-top: 24px;
    font-size: 0.875rem;
    color: var(--mute);
  }

  @media (max-width: 860px) {
    .form,
    .channels {
      grid-column: 1 / -1;
    }
    .channels {
      margin-top: 64px;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const button = form.querySelector<HTMLButtonElement>('[data-submit]')!;
  const label = button.querySelector<HTMLElement>('[data-label]')!;
  const status = form.querySelector<HTMLElement>('[data-status]')!;
  const error = form.querySelector<HTMLElement>('[data-error]')!;
  const idle = label.textContent;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form));
    button.disabled = true;
    label.textContent = form.dataset.sending!;
    error.hidden = true;
    status.textContent = '';
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          ...data,
          access_key: import.meta.env.PUBLIC_WEB3FORMS_KEY,
          subject: form.dataset.subject,
          from_name: 'paridemisuraca.com',
        }),
      });
      const json = await res.json();
      if (!json.success) throw new Error(json.message);
      form.reset();
      status.textContent = form.dataset.sent!;
    } catch (err) {
      console.error(err);
      error.hidden = false;
    } finally {
      button.disabled = false;
      label.textContent = idle;
    }
  });

  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const text = btn.textContent;
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(btn.dataset.copy!);
      btn.textContent = btn.dataset.done!;
      setTimeout(() => (btn.textContent = text), 1600);
    });
  }
</script>
